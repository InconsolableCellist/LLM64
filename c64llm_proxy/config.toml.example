# C64 LLM Proxy Configuration
# Copy to config.toml and edit as needed

[api]
# OpenAI API endpoint (or compatible)
base_url = "https://api.openai.com/v1"

# API key (can also use OPENAI_API_KEY environment variable - recommended)
# key = "sk-..."

# Model to use
model = "gpt-3.5-turbo"

# Temperature (0.0 - 2.0, lower = more focused)
temperature = 0.7

# Maximum tokens in response
max_tokens = 2000

[storage]
# Directory for conversation storage
data_dir = "./data"

# Claude Code mode (/code on the C64): the proxy drives a `claude` CLI
# session and the C64 is its terminal. Requires Claude Code installed
# and authenticated on THIS host (interactive `claude` login, or
# `claude setup-token` for a headless token, or ANTHROPIC_API_KEY).
[claude]
# Path to the claude binary (use an absolute path - the proxy's PATH
# may not include ~/.local/bin)
command = "claude"
# Default project directory the agent works in
workdir = "~/code"
