# C64 LLM Proxy Configuration
# Copy to config.toml and edit as needed

[api]
# OpenAI API endpoint (or compatible)
base_url = "https://api.openai.com/v1"

# API key (can also use OPENAI_API_KEY environment variable - recommended)
# key = "sk-..."

# Model to use
model = "gpt-3.5-turbo"

# Temperature (0.0 - 2.0, lower = more focused)
temperature = 0.7

# Maximum tokens in response
max_tokens = 2000

[storage]
# Directory for conversation storage
data_dir = "./data"

# Scene illustrations (optional - needs Pillow and one backend below;
# with none configured the proxy just reports images as unavailable).
# Originals and converted blobs land in <data_dir>/images/<conv_id>/.
# See docs/12-image-backends.md for the full guide.
[images]
# ask  - the model suggests a scene, you confirm with /pic (default)
# auto - striking scenes illustrate themselves (rate-limited)
# off  - never
mode = "ask"

# gemini | openai | comfyui | fixture
backend = "gemini"

# Style wrapper prepended to every scene description. Unset = the built-in
# dark-fantasy text in images.py. Set to "" if your ComfyUI workflow
# already carries the style.
# style_prefix = ""

# --- backend: gemini (hosted; key from https://aistudio.google.com/apikey)
[images.gemini]
model = "gemini-2.5-flash-image"
# Key resolution: this setting, then the GEMINI_API_KEY env var
# (recommended - keeps secrets out of the config file).
# key = "..."

# --- backend: openai (anything serving POST /v1/images/generations:
# OpenAI, Together, LocalAI, ...). Key here or in C64LLM_IMAGES_KEY.
# [images.openai]
# base_url = "https://api.openai.com/v1"
# model = "dall-e-3"
# size = "1792x1024"    # landscape suits the C64's 320x200 frame;
#                       # 1024x1024 is the universally safe choice
# key = "..."

# --- backend: comfyui (local, free per image, full style control).
# Export your workflow in API format (Workflow -> Export (API)) and put
# the literal token {PROMPT} in the positive-prompt text box. ComfyUI has
# NO authentication: keep it on localhost or a trusted LAN/tailnet.
# [images.comfyui]
# url = "http://127.0.0.1:8188"
# workflow = "./comfyui_workflow_api.json"   # relative to this file
# timeout = 300           # seconds; raise on slow GPUs
# randomize_seed = true   # off = identical prompts return ComfyUI's cache

# --- backend: fixture (dry runs: always returns this file)
# [images.fixture]
# path = "./emu/fixtures/scene.png"

# Claude Code mode (/code on the C64): the proxy drives a `claude` CLI
# session and the C64 is its terminal. Requires Claude Code installed
# and authenticated on THIS host (interactive `claude` login, or
# `claude setup-token` for a headless token, or ANTHROPIC_API_KEY).
[claude]
# Path to the claude binary (use an absolute path - the proxy's PATH
# may not include ~/.local/bin)
command = "claude"
# Default project directory the agent works in
workdir = "~/code"
