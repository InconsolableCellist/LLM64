#include <windows.h>
#include "resource.h"

LLM64MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Menu...\tF1",          IDM_MENU
        MENUITEM SEPARATOR
        MENUITEM "&Connect",              IDM_CONNECT
        MENUITEM "&Disconnect",           IDM_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&New Conversation\tF2", IDM_NEWCONV
        MENUITEM "C&onversations...\tF5", IDM_CONVS
        MENUITEM SEPARATOR
        MENUITEM "&Save Picture As...",   IDM_SAVEPIC
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                 IDM_EXIT
    END
    POPUP "&Link"
    BEGIN
        MENUITEM "&Ping",                 IDM_PING
        MENUITEM "&Cancel Reply\tF3",     IDM_CANCEL
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Server...",            IDM_SERVER
        MENUITEM SEPARATOR
        /* Paper is a 1993 business application on white; the other is
           the C64's own palette on black. docs/16 section 6.3 - the
           point was always that it should be a setting.

           Mnemonics inside one popup have to be distinct: "&Server" and
           a "&Screen" beside it both answer to S, and the first one
           wins - so the theme item is C for C64. */
        MENUITEM "&Paper (black on white)",   IDM_THEME_PAPER
        MENUITEM "&C64 Screen (light on black)", IDM_THEME_SCREEN
        MENUITEM SEPARATOR
        MENUITEM "P&ictures...",              IDM_PICSET
    END
    /* The MDI window menu. It has to be a real popup that the frame can
       hand to the MDI client, which appends the child list to it. Its
       position in this bar is WINDOW_MENU_POS - keep them together. */
    POPUP "&Window"
    BEGIN
        /* The launcher's six toggles, with the keyboard spelled out.
           Same ids as the buttons, so all three routes - click, menu,
           Ctrl+number - land in one handler. */
        MENUITEM "Con&versation\tCtrl+1", IDM_TOGCONV
        MENUITEM "P&icture\tCtrl+2",      IDM_TOGPIC
        MENUITEM "&Music\tCtrl+3",        IDM_TOGMUS
        MENUITEM "C&haracter\tCtrl+4",    IDM_TOGCHR
        MENUITEM "In&ventory\tCtrl+5",    IDM_TOGINV
        MENUITEM "Note&book\tCtrl+6",     IDM_TOGNOTE
        MENUITEM "M&ap\tCtrl+7",          IDM_TOGMAP
        MENUITEM SEPARATOR
        MENUITEM "&New Conversation Window", IDM_NEWWINDOW
        MENUITEM "Em&pty the Notebook",      IDM_CLOSEPAPER
        MENUITEM SEPARATOR
        MENUITEM "&Default Layout",       IDM_DEFLAYOUT
        MENUITEM "&Cascade\tShift+F5",    IDM_CASCADE
        MENUITEM "&Tile\tShift+F4",       IDM_TILE
        MENUITEM "Arrange &Icons",        IDM_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About LLM64...",       IDM_ABOUT
    END
END

/* F2 and F3 have been on the menu since the spike without an accelerator
   table behind them, so they never did anything. F1 is the C64's main
   menu key and stays that here. */
LLM64ACC ACCELERATORS
BEGIN
    VK_F1, IDM_MENU,    VIRTKEY
    VK_F2, IDM_NEWCONV, VIRTKEY
    VK_F3, IDM_CANCEL,  VIRTKEY
    VK_F5, IDM_CONVS,   VIRTKEY
    /* Ctrl+1..5: the launcher without the mouse. 0x31 is VK '1'. */
    0x31,  IDM_TOGCONV, VIRTKEY, CONTROL
    0x32,  IDM_TOGPIC,  VIRTKEY, CONTROL
    0x33,  IDM_TOGMUS,  VIRTKEY, CONTROL
    0x34,  IDM_TOGCHR,  VIRTKEY, CONTROL
    0x35,  IDM_TOGINV,  VIRTKEY, CONTROL
    0x36,  IDM_TOGNOTE, VIRTKEY, CONTROL
    0x37,  IDM_TOGMAP,  VIRTKEY, CONTROL
END

/* The server-fed menu, as a 1993 program would have shown it: a modal
   box of pushbuttons you click. The buttons are made at run time
   because the proxy decides what is on it - so this resource holds only
   the frame and the way out. */
LLM64ACTIONS DIALOG 20, 20, 260, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Menu"
BEGIN
    /* Three lines, not one. The height was exactly one line of 3.1's
       dialog font, and a static that cannot wrap simply truncates - so
       on any host whose dialog font is wider (every modern Windows) the
       message lost its tail: "The proxy has not sent its me". */
    LTEXT       "", IDC_MENUTITLE, 10, 6, 240, 30
    PUSHBUTTON  "Close", IDCANCEL, 105, 150, 50, 14
END

/* The conversation browser: what the C64 does with a full-screen
   module, done the way 1993 did it - a list box and the verbs down the
   side. Load is the default button and a double-click; F5 is the same
   key the C64 uses. The titles arrive server-rendered (a '*' prefix
   means starred), so the box holds no opinions of its own. */
LLM64CONVS DIALOG 16, 16, 248, 152
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Conversations"
BEGIN
    LISTBOX         IDC_CONVLIST, 8, 8, 164, 136,
                    LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "&Load",          IDC_CONVLOAD, 180, 8,   60, 14
    PUSHBUTTON      "&New",           IDC_CONVNEW,  180, 26,  60, 14
    PUSHBUTTON      "&Star / Unstar", IDC_CONVSTAR, 180, 48,  60, 14
    PUSHBUTTON      "&Delete...",     IDC_CONVDEL,  180, 66,  60, 14
    PUSHBUTTON      "&More >",        IDC_CONVMORE, 180, 88,  60, 14
    PUSHBUTTON      "Close",          IDCANCEL,     180, 130, 60, 14
END

/* Picture behaviour. One checkbox for now, but the box exists so the
   next picture option has somewhere to live. The warning is the whole
   reason this defaults OFF: on a hosted backend every generated scene
   is a paid API call, and spending the player's money is the player's
   decision. */
LLM64PICS DIALOG 24, 24, 232, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pictures"
BEGIN
    CONTROL         "&Generate a picture for every location",
                    IDC_ROOMPICS, "BUTTON",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 10, 210, 10
    LTEXT           "Each new place in an adventure gets illustrated as \
you enter it; returning shows the same picture again for free. On a \
hosted image backend every NEW picture is a paid API call.",
                    -1, 10, 26, 212, 34
    DEFPUSHBUTTON   "OK",     IDOK,     120, 72, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 174, 72, 50, 14
END

/* Where the proxy is. On a machine with no command line this is the only
   way to change it, which is exactly the situation in a VM: retype the
   address rather than rebuild the disk it booted from. */
LLM64SERVER DIALOG 24, 24, 186, 84
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Server"
BEGIN
    LTEXT           "&Host:",            -1,  8, 10,  28,  8
    EDITTEXT                             IDC_HOST,  40,  8, 138, 12, ES_AUTOHSCROLL
    LTEXT           "&Port:",            -1,  8, 28,  28,  8
    EDITTEXT                             IDC_PORT,  40, 26,  48, 12, ES_AUTOHSCROLL
    CONTROL         "&Reconnect now", IDC_RECONNECT, "BUTTON",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 40, 46, 100, 10
    DEFPUSHBUTTON   "OK",                IDOK,      74, 64,  50, 14
    PUSHBUTTON      "Cancel",            IDCANCEL, 128, 64,  50, 14
END
