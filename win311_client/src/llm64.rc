#include <windows.h>
#include "resource.h"

LLM64MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Menu...\tF1",          IDM_MENU
        MENUITEM SEPARATOR
        MENUITEM "&Connect",              IDM_CONNECT
        MENUITEM "&Disconnect",           IDM_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&New Conversation\tF2", IDM_NEWCONV
        MENUITEM "C&onversations...\tF5", IDM_CONVS
        MENUITEM SEPARATOR
        MENUITEM "&Save Picture As...",   IDM_SAVEPIC
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                 IDM_EXIT
    END
    POPUP "&Link"
    BEGIN
        MENUITEM "&Ping",                 IDM_PING
        MENUITEM "&Cancel Reply\tF3, Esc", IDM_CANCEL
    END
    POPUP "&Settings"
    BEGIN
        MENUITEM "&Server...",            IDM_SERVER
        MENUITEM SEPARATOR
        /* Paper is a 1993 business application on white; the other is
           the C64's own palette on black. docs/16 section 6.3 - the
           point was always that it should be a setting.

           Mnemonics inside one popup have to be distinct: "&Server" and
           a "&Screen" beside it both answer to S, and the first one
           wins - so the theme item is C for C64. */
        MENUITEM "&Paper (black on white)",   IDM_THEME_PAPER
        MENUITEM "&C64 Screen (light on black)", IDM_THEME_SCREEN
        MENUITEM SEPARATOR
        MENUITEM "P&ictures...",              IDM_PICSET
    END
    /* Shorthand for the proxy's history commands - each item just types
       the command, so the C64 and this client stay one feature. Also on
       a right-click over the transcript (PaneProc). */
    POPUP "&Message"
    BEGIN
        MENUITEM "&Redo Reply",             IDM_REDO
        MENUITEM "Ret&con Last Exchange",   IDM_RETCON
        MENUITEM SEPARATOR
        MENUITEM "&Fork Conversation",      IDM_FORK
    END
    /* The MDI window menu. It has to be a real popup that the frame can
       hand to the MDI client, which appends the child list to it. Its
       position in this bar is WINDOW_MENU_POS - keep them together. */
    POPUP "&Window"
    BEGIN
        /* The launcher's six toggles, with the keyboard spelled out.
           Same ids as the buttons, so all three routes - click, menu,
           Ctrl+number - land in one handler. */
        MENUITEM "Con&versation\tCtrl+1", IDM_TOGCONV
        MENUITEM "P&icture\tCtrl+2",      IDM_TOGPIC
        MENUITEM "&Music\tCtrl+3",        IDM_TOGMUS
        MENUITEM "C&haracter\tCtrl+4",    IDM_TOGCHR
        MENUITEM "In&ventory\tCtrl+5",    IDM_TOGINV
        MENUITEM "Note&book\tCtrl+6",     IDM_TOGNOTE
        MENUITEM "M&ap\tCtrl+7",          IDM_TOGMAP
        MENUITEM SEPARATOR
        MENUITEM "&New Conversation Window", IDM_NEWWINDOW
        MENUITEM "Em&pty the Notebook",      IDM_CLOSEPAPER
        MENUITEM SEPARATOR
        MENUITEM "&Default Layout",       IDM_DEFLAYOUT
        MENUITEM "&Cascade\tShift+F5",    IDM_CASCADE
        MENUITEM "&Tile\tShift+F4",       IDM_TILE
        MENUITEM "Arrange &Icons",        IDM_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About LLM64...",       IDM_ABOUT
    END
END

/* F2 and F3 have been on the menu since the spike without an accelerator
   table behind them, so they never did anything. F1 is the C64's main
   menu key and stays that here. */
LLM64ACC ACCELERATORS
BEGIN
    VK_F1, IDM_MENU,    VIRTKEY
    VK_F2, IDM_NEWCONV, VIRTKEY
    VK_F3, IDM_CANCEL,  VIRTKEY
    /* Escape is F3's modern spelling: clear the selection if one is
       lit, else cancel the reply in flight. Dialogs run their own
       loop, so their Escape (close) is untouched by this. */
    VK_ESCAPE, IDM_CANCEL, VIRTKEY
    VK_F5, IDM_CONVS,   VIRTKEY
    /* Ctrl+1..5: the launcher without the mouse. 0x31 is VK '1'. */
    0x31,  IDM_TOGCONV, VIRTKEY, CONTROL
    0x32,  IDM_TOGPIC,  VIRTKEY, CONTROL
    0x33,  IDM_TOGMUS,  VIRTKEY, CONTROL
    0x34,  IDM_TOGCHR,  VIRTKEY, CONTROL
    0x35,  IDM_TOGINV,  VIRTKEY, CONTROL
    0x36,  IDM_TOGNOTE, VIRTKEY, CONTROL
    0x37,  IDM_TOGMAP,  VIRTKEY, CONTROL
END

/* The server-fed menu, as a 1993 program would have shown it: a modal
   box of pushbuttons you click. The buttons are made at run time
   because the proxy decides what is on it - so this resource holds only
   the frame and the way out. */
LLM64ACTIONS DIALOG 20, 20, 260, 170
/* WS_CAPTION stays, deliberately. chrome_dialog_msg answers
   WM_NCCALCSIZE and WM_NCPAINT and should win on Windows - but it
   cannot be verified under Wine, where the X window manager decorates
   dialogs no matter what style they carry. Leaving the style alone
   means that if our non-client handling ever fails to take, the host
   still draws a caption that works rather than none at all. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Menu"
BEGIN
    /* Three lines, not one. The height was exactly one line of 3.1's
       dialog font, and a static that cannot wrap simply truncates - so
       on any host whose dialog font is wider (every modern Windows) the
       message lost its tail: "The proxy has not sent its me". */
    LTEXT       "", IDC_MENUTITLE, 10, 6, 240, 30
    PUSHBUTTON  "Close", IDCANCEL, 105, 150, 50, 14
END

/* The conversation browser: what the C64 does with a full-screen
   module, done the way 1993 did it - a list box and the verbs down the
   side. Load is the default button and a double-click; F5 is the same
   key the C64 uses. The titles arrive server-rendered (a '*' prefix
   means starred), so the box holds no opinions of its own. */
LLM64CONVS DIALOG 16, 16, 248, 152
/* WS_CAPTION stays, deliberately. chrome_dialog_msg answers
   WM_NCCALCSIZE and WM_NCPAINT and should win on Windows - but it
   cannot be verified under Wine, where the X window manager decorates
   dialogs no matter what style they carry. Leaving the style alone
   means that if our non-client handling ever fails to take, the host
   still draws a caption that works rather than none at all. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Conversations"
BEGIN
    LISTBOX         IDC_CONVLIST, 8, 8, 164, 136,
                    LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "&Load",          IDC_CONVLOAD, 180, 8,   60, 14
    PUSHBUTTON      "&New",           IDC_CONVNEW,  180, 26,  60, 14
    PUSHBUTTON      "&Star / Unstar", IDC_CONVSTAR, 180, 48,  60, 14
    PUSHBUTTON      "&Delete...",     IDC_CONVDEL,  180, 66,  60, 14
    PUSHBUTTON      "&More >",        IDC_CONVMORE, 180, 88,  60, 14
    PUSHBUTTON      "Close",          IDCANCEL,     180, 130, 60, 14
END

/* Picture behaviour. One checkbox for now, but the box exists so the
   next picture option has somewhere to live. The warning is the whole
   reason this defaults OFF: on a hosted backend every generated scene
   is a paid API call, and spending the player's money is the player's
   decision. */
LLM64PICS DIALOG 24, 24, 232, 92
/* WS_CAPTION stays, deliberately. chrome_dialog_msg answers
   WM_NCCALCSIZE and WM_NCPAINT and should win on Windows - but it
   cannot be verified under Wine, where the X window manager decorates
   dialogs no matter what style they carry. Leaving the style alone
   means that if our non-client handling ever fails to take, the host
   still draws a caption that works rather than none at all. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pictures"
BEGIN
    CONTROL         "&Generate a picture for every location",
                    IDC_ROOMPICS, "BUTTON",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 10, 210, 10
    LTEXT           "Each new place in an adventure gets illustrated as \
you enter it; returning shows the same picture again for free. On a \
hosted image backend every NEW picture is a paid API call.",
                    -1, 10, 26, 212, 34
    DEFPUSHBUTTON   "OK",     IDOK,     120, 72, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 174, 72, 50, 14
END

/* Where the proxy is. On a machine with no command line this is the only
   way to change it, which is exactly the situation in a VM: retype the
   address rather than rebuild the disk it booted from. */
LLM64SERVER DIALOG 24, 24, 186, 84
/* WS_CAPTION stays, deliberately. chrome_dialog_msg answers
   WM_NCCALCSIZE and WM_NCPAINT and should win on Windows - but it
   cannot be verified under Wine, where the X window manager decorates
   dialogs no matter what style they carry. Leaving the style alone
   means that if our non-client handling ever fails to take, the host
   still draws a caption that works rather than none at all. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Server"
BEGIN
    LTEXT           "&Host:",            -1,  8, 10,  28,  8
    EDITTEXT                             IDC_HOST,  40,  8, 138, 12, ES_AUTOHSCROLL
    LTEXT           "&Port:",            -1,  8, 28,  28,  8
    EDITTEXT                             IDC_PORT,  40, 26,  48, 12, ES_AUTOHSCROLL
    CONTROL         "&Reconnect now", IDC_RECONNECT, "BUTTON",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 40, 46, 100, 10
    DEFPUSHBUTTON   "OK",                IDOK,      74, 64,  50, 14
    PUSHBUTTON      "Cancel",            IDCANCEL, 128, 64,  50, 14
END

/* Renaming a printed sheet. The name is the Notebook's index row, not
   the sheet's text - the title line printed on the paper stays as it
   arrived. */
LLM64RENAME DIALOG 24, 24, 190, 58
/* WS_CAPTION stays, deliberately - see the note on LLM64ACTIONS. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Sheet"
BEGIN
    LTEXT           "&Name:",  -1,        8, 10,  28,  8
    EDITTEXT        IDC_SHEETNAME,       40,  8, 142, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",      IDOK,     78, 38,  50, 14
    PUSHBUTTON      "Cancel",  IDCANCEL, 132, 38, 50, 14
END

/* Editing a sheet. The page itself is a Scrollback - committed lines in
   far blocks - which is a fine thing to read and a terrible thing to
   edit in place; so Edit is a round trip: the text comes out whole, a
   multiline EDIT does what EDITs do, and OK rebuilds the sheet from the
   result. WS_THICKFRAME because a document deserves a resizable window;
   the proc re-lays the controls in WM_SIZE. ES_WANTRETURN, or Enter
   would press OK instead of breaking a line - a trap in a text editor. */
LLM64SHEET DIALOG 8, 8, 300, 200
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Edit Sheet"
BEGIN
    EDITTEXT        IDC_SHEETTEXT, 6, 6, 288, 168,
                    ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL |
                    ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON   "OK",      IDOK,     190, 180, 50, 14
    PUSHBUTTON      "Cancel",  IDCANCEL, 244, 180, 50, 14
END

/* Help > About: what this program is, who wrote it, and what it costs.
   The same three things the C64 client says on its welcome screen, and
   for the same reason - a shareware program has to tell you it is one,
   and it is the only place in the program that can.

   Every block is allotted at least one line more than the text needs at
   3.1's dialog font. Dialog units scale with the font, so the widths
   carry across to a modern host, but a wider face wraps a paragraph at
   different words and can spill a line - the slack absorbs it. */
LLM64ABOUT DIALOG 30, 24, 232, 190
/* WS_CAPTION stays, deliberately - see the note on LLM64ACTIONS. */
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About LLM64"
BEGIN
    /* SS_NOPREFIX throughout: '&' is a literal ampersand in prose, and
       without it "D&D" prints as "DD" with the second D underlined. */
    LTEXT   "LLM64 for Windows", -1, 12, 10, 208, 10, SS_NOPREFIX
    LTEXT   "An infinite D&D-style text adventure, an AI assistant and a \
chat client, played against a local or remote Large Language Model \
through the LLM64 proxy.",
            -1, 12, 24, 208, 40, SS_NOPREFIX
    LTEXT   "(C) Foxipso 2026", -1, 12, 70, 208, 10, SS_NOPREFIX
    LTEXT   "foxipso.com",      -1, 12, 82, 208, 10, SS_NOPREFIX
    LTEXT   "LLM64 is donationware. If you enjoy it, please consider \
supporting my work - the recommended donation is $10.",
            -1, 12, 100, 208, 30, SS_NOPREFIX
    LTEXT   "ko-fi.com/foxipso",     -1, 12, 134, 208, 10, SS_NOPREFIX
    LTEXT   "patreon.com/c/foxipso", -1, 12, 146, 208, 10, SS_NOPREFIX
    PUSHBUTTON      "&Visit foxipso.com", IDC_ABOUTWWW, 46, 168, 80, 14
    DEFPUSHBUTTON   "OK",                 IDOK,        136, 168, 50, 14
END

/* The message box, ours.
 *
 * MessageBox() draws the host's, and on Windows 11 that is the one
 * surface in the program still wearing 2026: a modern caption, modern
 * buttons, a modern font and a #F0F0F0 body inside a #C0C0C0
 * application. It is also the only dialog here that cannot be a fixed
 * template, because the text decides how tall it is - MsgDlgProc
 * measures the string and grows the box around it.
 *
 * Two buttons, always the same ids. MB_YESNO relabels them and the
 * wrapper maps the answer back, which keeps Escape working: the dialog
 * manager sends IDCANCEL, and on a Yes/No box that is No.
 *
 * No icon, deliberately. 3.1's stop sign and question mark are 32x32
 * bitmaps we do not have and could not measure, and LoadIcon would hand
 * back the host's - right on 3.11 and a 2026 tell everywhere else. A
 * message box without an icon is period-plausible; a 2026 icon is not.
 */
/* One line tall, and no taller. MsgDlgProc measures the string and grows
   the static, the buttons and the box to suit, so this height is a floor
   rather than a guess - which matters because the same message needs
   more rows on a host with a wider dialog font than 3.1 had. */
LLM64MSG DIALOG 40, 40, 200, 50
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LLM64"
BEGIN
    LTEXT           "", IDC_MSGTEXT, 12, 10, 176, 10
    DEFPUSHBUTTON   "OK",     IDOK,      44, 30, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 106, 30, 50, 14
END
