# LLM64 Proxy Configuration
# Copy to config.toml and edit as needed

[api]
# OpenAI API endpoint (or compatible)
base_url = "https://api.openai.com/v1"

# API key (can also use OPENAI_API_KEY environment variable - recommended)
# key = "sk-..."

# Model to use
model = "gpt-3.5-turbo"

# Temperature (0.0 - 2.0, lower = more focused)
temperature = 0.7

# Maximum tokens in response
max_tokens = 2000

[storage]
# Directory for conversation storage
data_dir = "./data"

# Scene illustrations (optional - needs Pillow and one backend below;
# with none configured the proxy just reports images as unavailable).
# Originals and converted blobs land in <data_dir>/images/<conv_id>/.
# See docs/12-image-backends.md for the full guide.
[images]
# ask  - the model suggests a scene, you confirm with /pic (default)
# auto - striking scenes illustrate themselves (rate-limited)
# off  - never
mode = "ask"

# gemini | openai | comfyui | fixture
backend = "gemini"

# Style wrapper prepended to every scene description. Unset = the built-in
# dark-fantasy text in images.py. Set to "" if your ComfyUI workflow
# already carries the style.
# style_prefix = ""

# --- backend: gemini (hosted; key from https://aistudio.google.com/apikey)
[images.gemini]
model = "gemini-2.5-flash-image"
# Key resolution: this setting, then the GEMINI_API_KEY env var
# (recommended - keeps secrets out of the config file).
# key = "..."

# --- backend: openai (anything serving POST /v1/images/generations:
# OpenAI, Together, LocalAI, ...). Key here or in LLM64_IMAGES_KEY.
# [images.openai]
# base_url = "https://api.openai.com/v1"
# model = "dall-e-3"
# size = "1792x1024"    # landscape suits the C64's 320x200 frame;
#                       # 1024x1024 is the universally safe choice
# key = "..."

# --- backend: comfyui (local, free per image, full style control).
# Export your workflow in API format (Workflow -> Export (API)) and put
# the literal token {PROMPT} in the positive-prompt text box. ComfyUI has
# NO authentication: keep it on localhost or a trusted LAN/tailnet.
# [images.comfyui]
# url = "http://127.0.0.1:8188"
# workflow = "./comfyui_workflow_api.json"   # relative to this file
# timeout = 300           # seconds; raise on slow GPUs
# randomize_seed = true   # off = identical prompts return ComfyUI's cache

# --- backend: fixture (dry runs: always returns this file)
# [images.fixture]
# path = "./emu/fixtures/scene.png"

# Claude Code mode (/code on the C64): the proxy drives a `claude` CLI
# session and the C64 is its terminal. Requires Claude Code installed
# and authenticated on THIS host (interactive `claude` login, or
# `claude setup-token` for a headless token, or ANTHROPIC_API_KEY).
[claude]
# Path to the claude binary (use an absolute path - the proxy's PATH
# may not include ~/.local/bin)
command = "claude"
# Default project directory the agent works in
workdir = "~/code"

# Hardcopy: /print sends a composed document to a printer on IEC
# device 4 (a real MPS-803, the C64 Ultimate's virtual printer, or
# VICE's - docs/14-printer-hardcopy.md). Nothing to enable here; the
# command works whenever the C64 has a printer on the bus.
[printer]
# Column the document wraps at - the PRINTER's width, not the screen's
# (an MPS-803 is 80 columns whichever mode the client is in).
width = 78
# Eject the page when the job ends. The C64 Ultimate otherwise keeps a
# partial page in its buffer until you use F5 -> Flush/Eject.
formfeed = true
# Generation budget for the document /print composes - deliberately NOT
# api.max_tokens, which is kept small so ordinary replies reach the C64
# fast. At 78 columns 800 tokens runs dry around line 40 and stops
# mid-sentence with no error; 2000 covers a full page with headroom.
# Costs a longer wait, but only on the one command that asked for paper.
max_tokens = 2000
# Where paper comes out: "c64" = the IEC printer on device 4 (default;
# no CUPS involved), "cups" = a CUPS queue on the proxy side instead
# (works with no C64 printer at all), "both" = one document, two
# deliveries, each reporting its own status on the C64.
backend = "c64"
# CUPS queue name - required for "cups"/"both", else the backend falls
# back to "c64" with a warning in the proxy log. Setup runbook:
# tools/setup-printer-pi.sh and docs/14-printer-hardcopy.md 13.
cups_queue = ""
# Empty = the local cupsd. For a print bridge (e.g. a Raspberry Pi with
# the printer on its USB, sharing the queue over IPP) put host[:port]
# here - prefer its mDNS name over an IP: "printpi.local:631".
cups_server = ""
# Passed to lp as -o. 78 columns doesn't fit an A4 page at CUPS's 10 cpi
# default; 12 cpi holds 87. Empty = whatever the queue defaults to.
# A roll printer also needs its page size here, or CUPS renders a full
# A4 width and the driver crops every line - for an 80mm till roll:
# cups_options = "cpi=12 lpi=8 PageSize=Custom.204x842"
cups_options = "cpi=12 lpi=8"
# Columns for the CUPS leg alone. 0 = use `width` above, which is right
# for an ordinary A4 printer. A roll printer is NOT 78 columns: an 80mm
# head prints 576 dots = 72mm = ~34 columns at 12 cpi. Wrapping wide and
# letting the driver crop loses the right-hand end of every line.
cups_width = 0
# Blank lines after the document. A till roll stops with its last line
# inside the mechanism, below the tear bar, so tearing takes the end of
# the page with it; ~5 lines at lpi=8 clears it. 0 for a page printer,
# which ejects on its own.
cups_feed_lines = 0
