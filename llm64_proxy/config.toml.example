# LLM64 Proxy Configuration
# Copy to config.toml and edit as needed

[api]
# OpenAI API endpoint (or compatible)
base_url = "https://api.openai.com/v1"

# API key (can also use OPENAI_API_KEY environment variable - recommended)
# key = "sk-..."

# Model to use
model = "gpt-3.5-turbo"

# Temperature (0.0 - 2.0, lower = more focused)
temperature = 0.7

# Maximum tokens in response
max_tokens = 2000

# Longest silent pause the API is allowed mid-request, in seconds
# (streaming resets it on every chunk). Raise it for big local models
# that load or prompt-eval slowly. The proxy keeps the client's
# watchdog fed for the whole wait, so this can be generous.
# read_timeout = 600

[storage]
# Directory for conversation storage
data_dir = "./data"

# Scene illustrations (optional - needs Pillow and one backend below;
# with none configured the proxy just reports images as unavailable).
# Originals and converted blobs land in <data_dir>/images/<conv_id>/.
# See docs/12-image-backends.md for the full guide.
[images]
# Nothing in this section can be judged by reading it. The launcher's
# Illustrations tab generates one picture from these settings as they
# stand - unsaved edits included - and shows what each client would
# display; see README "Previewing illustrations".
#
# ask  - the model suggests a scene, you confirm with /pic (default)
# auto - striking scenes illustrate themselves (rate-limited)
# off  - never
mode = "ask"

# gemini | openai | comfyui | fixture
backend = "gemini"

# Style wrapper prepended to every scene description. Unset = the built-in
# dark-fantasy text in images.py. Set to "" if your ComfyUI workflow
# already carries the style.
# style_prefix = ""

# Or pick a named style preset instead: a prefix plus optional ComfyUI
# overrides (model, sampler, a LoRA), switched with one key. Built in:
# cinematic (moody film still + the MovieClips LoRA), oil-chiaroscuro,
# painted-noir. A preset's prefix wins over style_prefix above. Unknown
# names warn and fall back to the default look.
# style = "cinematic"

# Your own presets are [images.styles.<name>] tables; one that reuses a
# built-in name overrides it key by key. style_prefix is the look (end
# it in "Scene: "); the other keys are optional. model/clip/vae/steps/
# cfg/sampler/scheduler override [images.comfyui] below; a lora runs
# via the bundled flux2-klein-lora.json workflow (drop the file in
# ComfyUI's models/loras first) unless `workflow` names your own.
# [images.styles.mystyle]
# style_prefix = "A woodcut in two colors, heavy black ink. Scene: "
# lora = "my-style.safetensors"
# lora_strength = 0.8
# steps = 12

# --- backend: gemini (hosted; key from https://aistudio.google.com/apikey)
[images.gemini]
model = "gemini-2.5-flash-image"
# Key resolution: this setting, then the GEMINI_API_KEY env var
# (recommended - keeps secrets out of the config file).
# key = "..."

# --- backend: openai (anything serving POST /v1/images/generations:
# OpenAI, Together, LocalAI, ...). Key here or in LLM64_IMAGES_KEY.
# [images.openai]
# base_url = "https://api.openai.com/v1"
# model = "dall-e-3"
# size = "1792x1024"    # landscape suits the C64's 320x200 frame;
#                       # 1024x1024 is the universally safe choice
# key = "..."

# --- backend: comfyui (local, free per image, full style control).
# ComfyUI has NO authentication: keep it on localhost or a trusted
# LAN/tailnet.
#
# workflows/flux2-klein-retro.json ships ready to use and is the default
# when `workflow` is unset - backend = "comfyui" alone is a working
# setup. To adapt your own, export it in API format (Workflow -> Export
# (API)) and put {PROMPT} in the positive-prompt box; the tokens below
# work anywhere in any node input, and a box holding EXACTLY one token
# keeps that token's type, so "width": "{WIDTH}" arrives as an integer.
#
# [images.comfyui]
# url = "http://127.0.0.1:8188"
# workflow = "my-workflow.json"   # relative to this file; a bare name
#                                 # also matches the bundled workflows
# timeout = 300           # seconds; raise on slow GPUs
# randomize_seed = true   # off = identical prompts return ComfyUI's cache
# seed = 12345            # pin it to compare prompts; omit to vary
#
# {WIDTH}/{HEIGHT} - default 1024x640. Keep the 1.6:1: the C64 frame is
#   320x200 and imaging.py letterboxes into it, so a square generation
#   throws a third of the picture away as black bars.
# width = 1024
# height = 640
#
# {STEPS} {CFG} {SAMPLER} {SCHEDULER} {SHIFT} - sampler settings. The
#   defaults suit flux-2-klein (8 steps, cfg 1). NOTE cfg = 1 disables
#   classifier-free guidance, which means the NEGATIVE PROMPT DOES
#   NOTHING - the style has to live in the positive prompt. That is
#   normal for a guidance-distilled model, and raising cfg to make the
#   negative bite usually costs more quality than it buys.
# steps = 8
# cfg = 1.0
#
# {MODEL} {CLIP} {VAE} - checkpoint filenames as ComfyUI sees them. The
#   launcher's ↻ buttons list what the running instance actually has.
# model = "flux-2-klein-9b-fp8.safetensors"
# clip = "qwen_3_8b_fp8mixed.safetensors"
# vae = "flux2-vae.safetensors"
#
# {NEGATIVE} - see the cfg note above before tuning this.
# negative = "text, watermark, border, blurry"
#
# {STYLE} - era styling, and empty by default so that [images].style_prefix
#   above is the single place style comes from. Set style_prefix = "" if
#   you move it here instead; setting both applies both.
#
#   For a C64 client, style_prefix's built-in text is already right: bold
#   16-colour, flat areas, strong silhouettes - which is what survives a
#   160x200 dither. For a Windows 3.11 / DOS client, more detail survives,
#   so a VGA look pays off:
#
# style = "256-color VGA pixel art from a 1993 MS-DOS adventure game, hand-dithered gradients, visible pixels, painted backdrop in the style of Sierra and LucasArts VGA. Moody night scenes, fog and glow are drawn with dither patterns and a restrained palette, never soft focus or photographic rendering. No text, no UI, no border. Scene: "
#
# Anything else your workflow templates, for nodes this proxy has never
# heard of - {LORA} and {LORA_STRENGTH} here:
# [images.comfyui.vars]
# LORA = "c64-art.safetensors"
# LORA_STRENGTH = "0.8"

# --- backend: fixture (dry runs: always returns this file)
# [images.fixture]
# path = "./emu/fixtures/scene.png"

# Claude Code mode (/code on the C64): the proxy drives a `claude` CLI
# session and the C64 is its terminal. Requires Claude Code installed
# and authenticated on THIS host (interactive `claude` login, or
# `claude setup-token` for a headless token, or ANTHROPIC_API_KEY).
[claude]
# Path to the claude binary (use an absolute path - the proxy's PATH
# may not include ~/.local/bin)
command = "claude"
# Default project directory the agent works in
workdir = "~/code"

# Hardcopy: /print sends a composed document to a printer on IEC
# device 4 (a real MPS-803, the C64 Ultimate's virtual printer, or
# VICE's - docs/14-printer-hardcopy.md). Nothing to enable here; the
# command works whenever the C64 has a printer on the bus.
[printer]
# Column the document wraps at - the PRINTER's width, not the screen's
# (an MPS-803 is 80 columns whichever mode the client is in).
width = 78
# Eject the page when the job ends. The C64 Ultimate otherwise keeps a
# partial page in its buffer until you use F5 -> Flush/Eject.
formfeed = true
# Generation budget for the document /print composes - deliberately NOT
# api.max_tokens, which is kept small so ordinary replies reach the C64
# fast. At 78 columns 800 tokens runs dry around line 40 and stops
# mid-sentence with no error; 2000 covers a full page with headroom.
# Costs a longer wait, but only on the one command that asked for paper.
max_tokens = 2000
# Where paper comes out: "c64" = the IEC printer on device 4 (default;
# no CUPS involved), "cups" = a CUPS queue on the proxy side instead
# (works with no C64 printer at all), "both" = one document, two
# deliveries, each reporting its own status on the C64.
backend = "c64"
# CUPS queue name - required for "cups"/"both", else the backend falls
# back to "c64" with a warning in the proxy log. Setup runbook:
# tools/setup-printer-pi.sh and docs/14-printer-hardcopy.md 13.
cups_queue = ""
# Empty = the local cupsd. For a print bridge (e.g. a Raspberry Pi with
# the printer on its USB, sharing the queue over IPP) put host[:port]
# here - prefer its mDNS name over an IP: "printpi.local:631".
cups_server = ""
# Passed to lp as -o. 78 columns doesn't fit an A4 page at CUPS's 10 cpi
# default; 12 cpi holds 87. Empty = whatever the queue defaults to.
# A roll printer also needs its page size here, or CUPS renders a full
# A4 width and the driver crops every line - for an 80mm till roll:
# cups_options = "cpi=12 lpi=8 PageSize=Custom.204x842"
cups_options = "cpi=12 lpi=8"
# Columns for the CUPS leg alone. 0 = use `width` above, which is right
# for an ordinary A4 printer. A roll printer is NOT 78 columns: an 80mm
# head prints 576 dots = 72mm = ~34 columns at 12 cpi. Wrapping wide and
# letting the driver crop loses the right-hand end of every line.
cups_width = 0
# Blank lines after the document. A till roll stops with its last line
# inside the mechanism, below the tear bar, so tearing takes the end of
# the page with it; ~5 lines at lpi=8 clears it. 0 for a page printer,
# which ejects on its own.
cups_feed_lines = 0
# "/print the picture" puts the conversation's last illustration on the
# CUPS printer (never the C64's - a bitmap is not a text stream).
# scale = printer dots per C64 pixel: 4 is one ordered-halftone cell per
# pixel and 6.3in wide at 203 dpi. Raise in steps of 4.
cups_pic_scale = 4
# The queue's real dot pitch. Stamped into the PNG and passed to lp as
# `ppi`; if they disagree CUPS rescales and moires the halftone.
cups_pic_dpi = 203
