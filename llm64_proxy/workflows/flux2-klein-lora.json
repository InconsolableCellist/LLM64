{
    "_comment": [
        "ComfyUI API-format workflow for LLM64 scene illustrations:",
        "flux2-klein-retro.json plus one LoraLoaderModelOnly node (75)",
        "between the UNET loader and the sampler. Selected automatically",
        "when an [images.styles.*] preset carries a lora (imgstyles.py);",
        "{LORA} and {LORA_STRENGTH} are filled from that preset via",
        "[images.comfyui.vars]. Running this workflow WITHOUT those vars",
        "set fails ComfyUI validation - there are no defaults for them",
        "in imagegen.COMFY_DEFAULTS.",
        "",
        "A node input that is EXACTLY one token keeps that token's type, so",
        "\"strength_model\": \"{LORA_STRENGTH}\" arrives as a float.",
        "",
        "{HEIGHT} defaults to 640 against a 1024 width because the C64 frame",
        "is 320x200 and imaging.py letterboxes into it: a square generation",
        "loses a third of the picture to black bars. 1.6:1 fills it.",
        "",
        "This key is ignored by ComfyUI - it is not a node."
    ],
    "9": {
        "inputs": {
            "filename_prefix": "llm64",
            "images": ["65", 0]
        },
        "class_type": "SaveImage",
        "_meta": {"title": "Save Image"}
    },
    "62": {
        "inputs": {
            "clip_name": "{CLIP}",
            "type": "lumina2",
            "device": "default"
        },
        "class_type": "CLIPLoader",
        "_meta": {"title": "Load CLIP"}
    },
    "63": {
        "inputs": {
            "vae_name": "{VAE}"
        },
        "class_type": "VAELoader",
        "_meta": {"title": "Load VAE"}
    },
    "65": {
        "inputs": {
            "samples": ["70", 0],
            "vae": ["63", 0]
        },
        "class_type": "VAEDecode",
        "_meta": {"title": "VAE Decode"}
    },
    "66": {
        "inputs": {
            "unet_name": "{MODEL}",
            "weight_dtype": "default"
        },
        "class_type": "UNETLoader",
        "_meta": {"title": "Load Diffusion Model"}
    },
    "67": {
        "inputs": {
            "text": "{STYLE}{PROMPT}",
            "clip": ["62", 0]
        },
        "class_type": "CLIPTextEncode",
        "_meta": {"title": "CLIP Text Encode (Positive)"}
    },
    "68": {
        "inputs": {
            "width": "{WIDTH}",
            "height": "{HEIGHT}",
            "batch_size": 1
        },
        "class_type": "EmptySD3LatentImage",
        "_meta": {"title": "Empty Latent"}
    },
    "69": {
        "inputs": {
            "shift": "{SHIFT}",
            "model": ["75", 0]
        },
        "class_type": "ModelSamplingAuraFlow",
        "_meta": {"title": "ModelSamplingAuraFlow"}
    },
    "70": {
        "inputs": {
            "seed": "{SEED}",
            "steps": "{STEPS}",
            "cfg": "{CFG}",
            "sampler_name": "{SAMPLER}",
            "scheduler": "{SCHEDULER}",
            "denoise": 1,
            "model": ["69", 0],
            "positive": ["67", 0],
            "negative": ["71", 0],
            "latent_image": ["68", 0]
        },
        "class_type": "KSampler",
        "_meta": {"title": "KSampler"}
    },
    "71": {
        "inputs": {
            "text": "{NEGATIVE}",
            "clip": ["62", 0]
        },
        "class_type": "CLIPTextEncode",
        "_meta": {"title": "CLIP Text Encode (Negative)"}
    },
    "75": {
        "inputs": {
            "lora_name": "{LORA}",
            "strength_model": "{LORA_STRENGTH}",
            "model": ["66", 0]
        },
        "class_type": "LoraLoaderModelOnly",
        "_meta": {"title": "LoRA"}
    }
}
